{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "offload/stage2/common.schema.json",
  "title": "Shared definitions for Stage 2 contracts",
  "$defs": {
    "ulid": {
      "type": "string",
      "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$",
      "description": "ULID, sortable by time"
    },
    "uuid": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "tsMs": {
      "type": "integer",
      "minimum": 0,
      "description": "unix epoch milliseconds, UTC"
    },
    "day": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
      "description": "local calendar day YYYY-MM-DD"
    },
    "month": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "instanceRef": {
      "type": "string",
      "pattern": "^[0-9a-f]{32}$",
      "description": "HMAC-SHA256(deviceEvidenceKey, localInstanceId), first 32 hex chars (ADR 0103). Resolves to content only on the device."
    },
    "seconds": {
      "type": "integer",
      "minimum": 0,
      "description": "whole seconds"
    },
    "cents": {
      "type": "integer",
      "minimum": 0,
      "description": "USD minor units"
    },
    "accessRole": {
      "enum": [
        "owner",
        "admin",
        "dept_lead",
        "member",
        "auditor",
        "service"
      ]
    },
    "jurisdiction": {
      "type": "string",
      "pattern": "^[A-Z]{2}(-[A-Z0-9]{1,3})?$",
      "description": "ISO 3166-1 alpha-2, optionally with ISO 3166-2 subdivision, e.g. CA-ON, US-NY, DE"
    },
    "sensitiveFeature": {
      "enum": [
        "per_person_views",
        "working_time"
      ]
    },
    "feature": {
      "enum": [
        "workflow_metrics",
        "per_person_views",
        "working_time"
      ]
    },
    "runOutcome": {
      "enum": [
        "success",
        "failed",
        "cancelled",
        "rejected",
        "capped"
      ]
    },
    "runtime": {
      "enum": [
        "mac",
        "cloud"
      ]
    },
    "capability": {
      "type": "string",
      "maxLength": 120,
      "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)+$",
      "description": "s13 capability vocabulary, e.g. mail.send, sheet.append, web.research"
    },
    "stepClass": {
      "enum": [
        "read",
        "draft",
        "commit"
      ]
    },
    "ownership": {
      "enum": [
        "company",
        "personal-allowed",
        "personal-forbidden"
      ]
    },
    "connectionKind": {
      "enum": [
        "gmail",
        "google_workspace_shared",
        "outlook",
        "m365_shared_mailbox",
        "composio_org",
        "company_mcp",
        "api",
        "crm",
        "company_linkedin_page",
        "linkedin_personal",
        "other"
      ]
    },
    "personState": {
      "enum": [
        "active",
        "leaving",
        "frozen",
        "departed"
      ]
    },
    "approverKind": {
      "enum": [
        "person",
        "policy"
      ]
    },
    "plainText": {
      "type": "string",
      "maxLength": 2000,
      "description": "plain words, no control characters except newline"
    },
    "name": {
      "type": "string",
      "maxLength": 120,
      "minLength": 1
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "id"
      ],
      "properties": {
        "type": {
          "enum": [
            "company",
            "department",
            "job_role",
            "person"
          ]
        },
        "id": {
          "oneOf": [
            {
              "$ref": "common.schema.json#/$defs/uuid"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "description": "Aggregation scope. id is null for company."
    },
    "suppressed": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "suppressed",
        "reason"
      ],
      "properties": {
        "suppressed": {
          "const": true
        },
        "reason": {
          "enum": [
            "group_floor",
            "feature_disabled",
            "jurisdiction"
          ]
        }
      },
      "description": "Returned instead of numbers when a cell may not be shown (ADR 0103 \u00a75, ADR 0108)."
    },
    "page": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "nextCursor"
      ],
      "properties": {
        "nextCursor": {
          "oneOf": [
            {
              "type": "string",
              "maxLength": 200
            },
            {
              "type": "null"
            }
          ]
        }
      }
    }
  }
}
