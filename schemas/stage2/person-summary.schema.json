{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "offload/stage2/person-summary.schema.json",
  "title": "Person summary: what a department lead sees about a person in scope (ADR 0111 §2)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "displayName",
    "departmentId",
    "jobRoleIds",
    "state"
  ],
  "properties": {
    "id": {
      "$ref": "common.schema.json#/$defs/uuid"
    },
    "displayName": {
      "$ref": "common.schema.json#/$defs/name"
    },
    "departmentId": {
      "oneOf": [
        {
          "$ref": "common.schema.json#/$defs/uuid"
        },
        {
          "type": "null"
        }
      ]
    },
    "jobRoleIds": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/uuid"
      },
      "maxItems": 20
    },
    "state": {
      "$ref": "common.schema.json#/$defs/personState"
    }
  }
}
