{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "offload/stage2/self-view.schema.json",
  "title": "GET /v1/me/data: everything the control plane holds about the caller (ADR 0108 \u00a74).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "person",
    "features",
    "acks",
    "devices",
    "hoursSaved",
    "dailyAggregates",
    "workingTime",
    "runs",
    "accessLog",
    "retention"
  ],
  "properties": {
    "person": {
      "$ref": "person.schema.json"
    },
    "features": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "workflow_metrics",
        "per_person_views",
        "working_time"
      ],
      "properties": {
        "workflow_metrics": {
          "type": "boolean"
        },
        "per_person_views": {
          "type": "boolean"
        },
        "working_time": {
          "type": "boolean"
        }
      }
    },
    "acks": {
      "type": "array",
      "items": {
        "$ref": "notice-ack.schema.json"
      },
      "maxItems": 100
    },
    "devices": {
      "type": "array",
      "items": {
        "$ref": "device-enrollment.schema.json#/$defs/device"
      },
      "maxItems": 20
    },
    "hoursSaved": {
      "$ref": "hours-saved-report.schema.json"
    },
    "dailyAggregates": {
      "type": "array",
      "items": {
        "$ref": "daily-aggregate.schema.json"
      },
      "maxItems": 400
    },
    "workingTime": {
      "type": "array",
      "items": {
        "$ref": "working-time-aggregate.schema.json"
      },
      "maxItems": 400
    },
    "runs": {
      "type": "array",
      "items": {
        "$ref": "run-outcome.schema.json"
      },
      "maxItems": 1000
    },
    "accessLog": {
      "type": "array",
      "items": {
        "$ref": "audit-event.schema.json"
      },
      "maxItems": 1000
    },
    "retention": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "perPersonDays",
        "workingTimeDays"
      ],
      "properties": {
        "perPersonDays": {
          "type": "integer",
          "minimum": 1,
          "maximum": 90
        },
        "workingTimeDays": {
          "type": "integer",
          "minimum": 1,
          "maximum": 30
        }
      }
    }
  }
}
