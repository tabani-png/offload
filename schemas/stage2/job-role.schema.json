{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "offload/stage2/job-role.schema.json",
  "title": "Job role DTO: workflows belong to job roles (CONTEXT).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "name",
    "departmentId",
    "roleIdentityIds",
    "holderPersonIds"
  ],
  "properties": {
    "id": {
      "$ref": "common.schema.json#/$defs/uuid"
    },
    "name": {
      "$ref": "common.schema.json#/$defs/name"
    },
    "departmentId": {
      "$ref": "common.schema.json#/$defs/uuid"
    },
    "roleIdentityIds": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/uuid"
      },
      "maxItems": 10
    },
    "holderPersonIds": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/uuid"
      },
      "maxItems": 1000
    }
  }
}
