{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "offload/stage2/daily-aggregate.schema.json",
  "title": "Sync object: one person-day of workflow activity.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "kind",
    "createdAt",
    "day",
    "activeWorkflows",
    "workflows"
  ],
  "properties": {
    "id": {
      "$ref": "common.schema.json#/$defs/ulid"
    },
    "kind": {
      "const": "daily_aggregate"
    },
    "createdAt": {
      "$ref": "common.schema.json#/$defs/tsMs"
    },
    "day": {
      "$ref": "common.schema.json#/$defs/day"
    },
    "activeWorkflows": {
      "type": "integer",
      "minimum": 0
    },
    "workflows": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "workflowId",
          "version",
          "runs",
          "successes",
          "savedSecondsDevice"
        ],
        "properties": {
          "workflowId": {
            "$ref": "common.schema.json#/$defs/uuid"
          },
          "version": {
            "type": "integer",
            "minimum": 1
          },
          "runs": {
            "type": "integer",
            "minimum": 0
          },
          "successes": {
            "type": "integer",
            "minimum": 0
          },
          "savedSecondsDevice": {
            "$ref": "common.schema.json#/$defs/seconds"
          }
        }
      },
      "maxItems": 200
    }
  }
}
