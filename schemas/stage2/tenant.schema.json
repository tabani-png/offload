{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "offload/stage2/tenant.schema.json",
  "title": "Tenant DTO",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "name",
    "createdAt",
    "reportingTimezone",
    "groupFloor",
    "identityAddon",
    "retention",
    "monthlyWorkerBudgetCents"
  ],
  "properties": {
    "id": {
      "$ref": "common.schema.json#/$defs/uuid"
    },
    "name": {
      "$ref": "common.schema.json#/$defs/name"
    },
    "createdAt": {
      "$ref": "common.schema.json#/$defs/tsMs"
    },
    "reportingTimezone": {
      "type": "string",
      "maxLength": 64
    },
    "groupFloor": {
      "type": "integer",
      "minimum": 5,
      "maximum": 100
    },
    "identityAddon": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sso",
        "directorySync"
      ],
      "properties": {
        "sso": {
          "type": "boolean"
        },
        "directorySync": {
          "type": "boolean"
        }
      }
    },
    "retention": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "perPersonDays",
        "workingTimeDays",
        "groupMonths"
      ],
      "properties": {
        "perPersonDays": {
          "type": "integer",
          "minimum": 1,
          "maximum": 90
        },
        "workingTimeDays": {
          "type": "integer",
          "minimum": 1,
          "maximum": 30
        },
        "groupMonths": {
          "type": "integer",
          "minimum": 1,
          "maximum": 24
        }
      }
    },
    "monthlyWorkerBudgetCents": {
      "$ref": "common.schema.json#/$defs/cents"
    }
  }
}
